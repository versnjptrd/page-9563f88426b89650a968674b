          "body": "<style>\n:root{\n  --abyss:#050d1a; --deep:#0b1f38; --mid:#123a63; --teal:#0e4a70;\n  --amber:#e6a94c; --amber-hi:#f3c274; --amber-dim:#c98a3a;\n  --ink:#eef4fb; --muted:#9db4cc; --faint:#6d87a3;\n  --line:rgba(230,169,76,.22); --line2:rgba(157,180,204,.16);\n  --serif:\"Songti SC\",\"STSong\",\"Noto Serif CJK SC\",\"Source Han Serif SC\",Georgia,\"Times New Roman\",serif;\n  --sans:\"PingFang SC\",\"Microsoft YaHei\",\"Hiragino Sans GB\",\"Segoe UI\",system-ui,-apple-system,sans-serif;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml{scroll-behavior:smooth}\nbody{background:var(--abyss);color:var(--ink);font-family:var(--sans);line-height:1.7;-webkit-font-smoothing:antialiased;font-size:16px}\nmain{max-width:1180px;margin:0 auto;padding:0 22px}\nsection{padding:clamp(48px,8vw,96px) 0;border-top:1px solid var(--line2)}\nsection:first-of-type{border-top:none}\n\n/* ---------- HERO : long-form narrative opening ---------- */\n.hero{position:relative;padding-top:34px}\n.kicker{display:flex;align-items:center;gap:12px;font-size:.78rem;letter-spacing:.28em;text-transform:uppercase;color:var(--amber);margin-bottom:26px}\n.kicker::before{content:\"\";width:34px;height:1px;background:var(--amber)}\n.hero h1{font-family:var(--serif);font-weight:700;font-size:clamp(2.6rem,7vw,4.6rem);line-height:1.05;letter-spacing:-.01em;margin-bottom:10px}\n.hero .sub{font-family:var(--serif);font-style:italic;color:var(--muted);font-size:clamp(1.05rem,2.4vw,1.35rem);margin-bottom:38px}\n.lede{font-family:var(--serif);font-size:clamp(1.25rem,3vw,1.7rem);line-height:1.55;color:var(--ink);max-width:60ch;margin-bottom:30px;border-left:3px solid var(--amber);padding-left:22px}\n.prose p{max-width:64ch;margin-bottom:20px;color:var(--muted)}\n.prose p strong{color:var(--ink);font-weight:600}\n.pullquote{font-family:var(--serif);font-size:clamp(1.4rem,3.4vw,2rem);line-height:1.4;color:var(--amber-hi);text-align:center;max-width:34ch;margin:44px auto;padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.anchor-nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:40px}\n.anchor-nav a{font-size:.85rem;letter-spacing:.04em;color:var(--ink);text-decoration:none;padding:9px 16px;border:1px solid var(--line);border-radius:999px;background:rgba(18,58,99,.35);transition:.2s}\n.anchor-nav a:hover{background:var(--amber);color:var(--abyss);border-color:var(--amber)}\n.dropcap::first-letter{font-family:var(--serif);float:left;font-size:3.6rem;line-height:.8;padding:6px 12px 0 0;color:var(--amber)}\n\n/* ---------- section heads ---------- */\n.head{margin-bottom:44px}\n.head .tag{font-size:.75rem;letter-spacing:.24em;text-transform:uppercase;color:var(--amber);margin-bottom:12px;display:block}\n.head h2{font-family:var(--serif);font-size:clamp(1.8rem,4.6vw,2.8rem);line-height:1.15;font-weight:700}\n.head p{color:var(--muted);max-width:58ch;margin-top:14px}\n\n/* ---------- principles : big numbered cards ---------- */\n.grid{display:grid;gap:26px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}\n.numcard{background:linear-gradient(160deg,var(--deep),var(--mid));border-radius:26px;padding:30px 28px 34px;position:relative;overflow:hidden;box-shadow:0 22px 44px rgba(0,0,0,.45);border:1px solid var(--line2)}\n.numcard .num{font-family:var(--serif);font-size:4.4rem;line-height:1;color:rgba(230,169,76,.16);position:absolute;top:14px;right:22px;font-weight:700}\n.numcard h3{font-size:1.2rem;margin-bottom:12px;color:var(--ink);position:relative}\n.numcard p{color:var(--muted);font-size:.96rem;position:relative}\n.numcard .bar{width:44px;height:3px;background:var(--amber);border-radius:2px;margin-bottom:18px}\n\n/* ---------- plans : stepped progression ---------- */\n.plans{display:flex;flex-direction:column;gap:22px}\n.plan{background:linear-gradient(150deg,var(--deep),var(--mid));border-radius:28px;padding:30px 30px 32px;box-shadow:0 24px 50px rgba(0,0,0,.5);border:1px solid var(--line2);position:relative}\n.p1{margin-left:0;width:min(100%,760px)}\n.p2{margin-left:clamp(0px,7vw,120px);width:min(100%,820px)}\n.p3{margin-left:clamp(0px,14vw,240px);width:min(100%,880px)}\n.plan.feat{border:1px solid var(--amber);box-shadow:0 24px 60px rgba(230,169,76,.18)}\n.ribbon{position:absolute;top:20px;right:24px;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--abyss);background:var(--amber);padding:5px 12px;border-radius:999px;font-weight:700}\n.plan .pname{font-family:var(--serif);font-size:1.5rem;font-weight:700}\n.plan .pdesc{color:var(--muted);font-size:.92rem;margin-top:4px}\n.price-row{display:flex;align-items:baseline;gap:14px;margin:20px 0 6px;flex-wrap:wrap}\n.price{font-family:var(--serif);font-size:2.3rem;font-weight:700;color:var(--amber-hi)}\n.price small{font-size:1rem;color:var(--muted);font-weight:400}\n.annual{font-size:.86rem;color:var(--faint)}\n.feats{list-style:none;margin-top:20px;display:grid;gap:11px}\n.feats li{padding-left:26px;position:relative;color:var(--ink);font-size:.96rem}\n.feats li::before{content:\"◆\";position:absolute;left:0;color:var(--amber);font-size:.7rem;top:5px}\n.step-label{font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--faint);margin-bottom:10px}\n\n/* ---------- clients ---------- */\n.client-grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}\n.client-card{background:rgba(18,58,99,.28);border:1px solid var(--line2);border-radius:22px;padding:26px 24px}\n.client-card h3{font-size:1.1rem;margin-bottom:10px;color:var(--ink);display:flex;align-items:center;gap:10px}\n.client-card h3 span{width:9px;height:9px;border-radius:50%;background:var(--amber);flex:none}\n.client-card p{color:var(--muted);font-size:.93rem;margin-bottom:14px}\n.note{font-size:.86rem;color:var(--faint);background:rgba(11,31,56,.6);border:1px dashed var(--line);border-radius:14px;padding:14px 16px;margin-top:26px}\n\n/* ---------- usage steps ---------- */\n.steps{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));counter-reset:s}\n.step{background:linear-gradient(160deg,var(--deep),var(--mid));border-radius:20px;padding:24px;position:relative;border:1px solid var(--line2)}\n.step::before{counter-increment:s;content:counter(s,decimal-leading-zero);font-family:var(--serif);font-size:2rem;color:var(--amber);opacity:.5;display:block;margin-bottom:10px}\n.step h3{font-size:1.05rem;margin-bottom:8px}\n.step p{color:var(--muted);font-size:.92rem}\n\n/* ---------- faq grouped ---------- */\n.faq-group{margin-bottom:38px}\n.faq-group>.glabel{font-family:var(--serif);font-size:1.25rem;color:var(--amber-hi);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--line)}\ndetails{background:rgba(18,58,99,.24);border:1px solid var(--line2);border-radius:16px;margin-bottom:12px;overflow:hidden}\nsummary{cursor:pointer;list-style:none;padding:18px 22px;font-weight:600;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:16px}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";color:var(--amber);font-size:1.4rem;font-weight:400;flex:none;transition:.2s}\ndetails[open] summary::after{transform:rotate(45deg)}\ndetails .ans{padding:0 22px 20px;color:var(--muted);font-size:.95rem}\ndetails[open]{border-color:var(--line)}\n\n/* ---------- footer ---------- */\nfooter{padding:56px 0 70px;border-top:1px solid var(--line2);color:var(--faint);font-size:.88rem}\nfooter .brand{font-family:var(--serif);font-size:1.6rem;color:var(--ink);margin-bottom:10px}\nfooter a{color:var(--amber);text-decoration:none}\nfooter .links{display:flex;flex-wrap:wrap;gap:16px;margin-top:18px}\n@media(max-width:640px){\n  .p2,.p3{margin-left:0}\n  .hero .lede{padding-left:16px}\n}\n</style><main>\n\n\n<section class=\"hero\" id=\"top\">\n  <div class=\"kicker\">专栏 · 第 01 期 · 关于一条稳定的路</div>\n  <h1>J20</h1>\n  <p class=\"sub\">深海之下，琥珀之光 —— 一份写给使用者的连接笔记</p>\n\n  <p class=\"lede dropcap\">把网络想象成海。表面有浪，深处有流。多数人只看见浪——快慢、抖动、断连；而真正决定体验的，是海面以下那条安静的水道。J20 想做的，就是把这条水道修得足够稳。</p>\n\n  <div class=\"prose\">\n    <p>我们不卖“更快”这个形容词。速度会被带宽、距离、时段反复拉扯，承诺它既轻率又难兑现。<strong>我们更在意确定性：</strong>同一时间打开视频不转圈，同一局游戏不掉线，同一台设备切换节点时几乎无感。这种确定，来自线路选择、节点分布与运维节奏，而不是宣传页上的数字。</p>\n    <p>于是有了三档方案。它们不是同一产品的三种包装，而是三种用量、三种场景、三种责任边界。个人日常用基础版就够；需要多设备、原生流媒体与游戏优化的，走旗舰版；当一台设备变成二十台，路由规则开始影响协作，团队版才登场。</p>\n    <p>价格透明，权益写在明处，没有隐藏条款。客户端覆盖常见系统，配置一次即可长期复用。下面继续往下读，你会看到原则、方案、客户端、使用步骤与按主题归类的问答——每一条都尽量短，因为短句比长段落更难说谎。</p>\n  </div>\n\n  <blockquote class=\"pullquote\">“稳定不是奇迹，是把重复的事做对一千次。”</blockquote>\n\n  <nav class=\"anchor-nav\" aria-label=\"页面锚点导航\">\n    <a href=\"#principles\">设计原则</a>\n    <a href=\"#plans\">三档方案</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#usage\">使用步骤</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n</section>\n\n\n<section id=\"principles\">\n  <div class=\"head\">\n    <span class=\"tag\">Principles</span>\n    <h2>四条底线，先于一切功能</h2>\n    <p>在讨论节点数量之前，先说清楚我们拒绝什么。这些约束决定了产品形状。</p>\n  </div>\n  <div class=\"grid\">\n    <article class=\"numcard\">\n      <span class=\"num\">01</span>\n      <div class=\"bar\"></div>\n      <h3>不夸大速度</h3>\n      <p>流量额度按周期计，而非瞬时峰值。我们展示可核查的使用上限，不写“极速无限”这类无法验证的字眼。</p>\n    </article>\n    <article class=\"numcard\">\n      <span class=\"num\">02</span>\n      <div class=\"bar\"></div>\n      <h3>线路分层清晰</h3>\n      <p>普通线路池负责日常，IPLC 专线专攻低延迟场景。谁该走哪条路，由方案档位决定，不由运气决定。</p>\n    </article>\n    <article class=\"numcard\">\n      <span class=\"num\">03</span>\n      <div class=\"bar\"></div>\n      <h3>支持有响应</h3>\n      <p>旗舰及以上享 7×24 优先工单，团队版另配专属客户经理。问题进来有人接，接了就有回音。</p>\n    </article>\n    <article class=\"numcard\">\n      <span class=\"num\">04</span>\n      <div class=\"bar\"></div>\n      <h3>边界写明处</h3>\n      <p>设备数、并发、定制能力都在条款里。超出边界的诉求走沟通，不在暗处偷偷限制或偷偷放行。</p>\n    </article>\n  </div>\n</section>\n\n\n<section id=\"plans\">\n  <div class=\"head\">\n    <span class=\"tag\">Plans · 阶梯式</span>\n    <h2>从一台设备，到一支团队</h2>\n    <p>三档方案逐级展开。越靠右下的卡片，承载的责任越多。价格与权益如下所列。</p>\n  </div>\n\n  <div class=\"plans\">\n    <article class=\"plan p1\">\n      <div class=\"step-label\">第一阶 · 起步</div>\n      <div class=\"pname\">基础版</div>\n      <div class=\"pdesc\">单人日常浏览、流媒体入门。</div>\n      <div class=\"price-row\">\n        <span class=\"price\">¥15<small>/月</small></span>\n        <span class=\"annual\">按年付仅需 ¥150/年</span>\n      </div>\n      <ul class=\"feats\">\n        <li>每月 100GB 流量额度</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体内容</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"plan p2 feat\">\n      <span class=\"ribbon\">推荐</span>\n      <div class=\"step-label\">第二阶 · 主力</div>\n      <div class=\"pname\">旗舰版</div>\n      <div class=\"pdesc\">多设备、原生流媒体与游戏优化的平衡之选。</div>\n      <div class=\"price-row\">\n        <span class=\"price\">¥35<small>/月</small></span>\n        <span class=\"annual\">按年付仅需 ¥350/年</span>\n      </div>\n      <ul class=\"feats\">\n        <li>每月 300GB 流量额度</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7×24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"plan p3\">\n      <div class=\"step-label\">第三阶 · 协作</div>\n      <div class=\"pname\">团队版</div>\n      <div class=\"pdesc\">面向小组与企业场景的高带宽与定制路由。</div>\n      <div class=\"price-row\">\n        <span class=\"price\">¥85<small>/月</small></span>\n        <span class=\"annual\">按年付仅需 ¥850/年</span>\n      </div>\n      <ul class=\"feats\">\n        <li>每月 1000GB 流量额度</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n  </div>\n</section>\n\n\n<section id=\"clients\">\n  <div class=\"head\">\n    <span class=\"tag\">Clients</span>\n    <h2>客户端：覆盖你已有的设备</h2>\n    <p>无需额外硬件。常见系统与终端均可接入，配置一次后随账号长期复用。</p>\n  </div>\n  <div class=\"client-grid\">\n    <article class=\"client-card\">\n      <h3><span></span>桌面端</h3>\n      <p>Windows 与 macOS 提供图形化界面，节点列表、测速入口与开关集中在一屏内完成。</p>\n    </article>\n    <article class=\"client-card\">\n      <h3><span></span>移动端</h3>\n      <p>iOS 与 Android 适配主流机型，后台常驻策略遵循系统规范，兼顾续航与连通。</p>\n    </article>\n    <article class=\"client-card\">\n      <h3><span></span>通用协议</h3>\n      <p>开放标准配置导入，兼容第三方客户端，便于在多平台间迁移同一份订阅。</p>\n    </article>\n    <article class=\"client-card\">\n      <h3><span></span>路由器 / 全屋</h3>\n      <p>支持在兼容固件上部署，实现局域网内多设备共享同一条出口链路。</p>\n    </article>\n  </div>\n  <p class=\"note\">说明：本页未收录经核实的官方下载地址，故此处不提供下载链接。各端安装方式请以购买后随账号发放的配置指引为准；如需具体版本信息，请通过工单向客服索取。</p>\n</section>\n\n\n<section id=\"usage\">\n  <div class=\"head\">\n    <span class=\"tag\">How to use</span>\n    <h2>四步接入，之后交给自动重连</h2>\n    <p>首次配置稍费心思，日常使用几乎零操作。</p>\n  </div>\n  <div class=\"steps\">\n    <article class=\"step\">\n      <h3>选定方案</h3>\n      <p>按设备数与用途挑一档：日常选基础，主力选旗舰，协作选团队。</p>\n    </article>\n    <article class=\"step\">\n      <h3>获取配置</h3>\n      <p>开通后取得订阅配置，直接导入客户端，或复制至通用协议工具。</p>\n    </article>\n    <article class=\"step\">\n      <h3>挑选节点</h3>\n      <p>看用途选线路：流媒体走原生解锁节点，游戏走 IPLC 专线节点。</p>\n    </article>\n    <article class=\"step\">\n      <h3>开启即用</h3>\n      <p>勾选开机自启与自动重连，此后换网、换设备均无需重新配置。</p>\n    </article>\n  </div>\n</section>\n\n\n<section id=\"faq\">\n  <div class=\"head\">\n    <span class=\"tag\">FAQ · 按主题归类</span>\n    <h2>常见问题</h2>\n    <p>答案尽量短。点开查看每一组的具体问答。</p>\n  </div>\n\n  <div class=\"faq-group\">\n    <div class=\"glabel\">一、计费与额度</div>\n    <details>\n      <summary>流量是按什么周期计算的？</summary>\n      <div class=\"ans\">按自然月重置，额度分别为 100GB（基础）、300GB（旗舰）、1000GB（团队）。当月未用完不结转至下月。</div>\n    </details>\n    <details>\n      <summary>年付和月付差在哪？</summary>\n      <div class=\"ans\">权益完全相同，仅结算周期不同。年付对应 ¥150 / ¥350 / ¥850，相当于每月单价不变但一次性锁定全年。</div>\n    </details>\n    <details>\n      <summary>超出流量会怎样？</summary>\n      <div class=\"ans\">达到上限后当期停止新增消耗，等待周期重置。不会因超量产生未告知的扣费。</div>\n    </details>\n  </div>\n\n  <div class=\"faq-group\">\n    <div class=\"glabel\">二、设备与并发</div>\n    <details>\n      <summary>能同时在几台设备上用？</summary>\n      <div class=\"ans\">基础 3 台、旗舰 5 台、团队 20 台。指同时在线的设备数，登录但不联网的不计入。</div>\n    </details>\n    <details>\n      <summary>手机、电脑、平板算多台吗？</summary>\n      <div class=\"ans\">算。每台独立终端占用一个并发位，可在客户端查看当前在线列表并主动下线闲置设备。</div>\n    </details>\n  </div>\n\n  <div class=\"faq-group\">\n    <div class=\"glabel\">三、线路与节点</div>\n    <details>\n      <summary>普通线路和 IPLC 专线有什么区别？</summary>\n      <div class=\"ans\">普通线路池承担日常访问；IPLC 专线面向低延迟场景，主要服务于旗舰版的加速优化需求。两者职责不同，非简单快慢之分。</div>\n    </details>\n    <details>\n      <summary>流媒体解锁包含哪些？</summary>\n      <div class=\"ans\">基础版解锁基础流媒体内容；旗舰版为全节点原生流媒体解锁。具体可用范围随上游变化，以节点实测为准。</div>\n    </details>\n    <details>\n      <summary>可以自定义路由吗？</summary>\n      <div class=\"ans\">团队版支持企业定制路由，用于按部门或业务划分出口策略。基础与旗舰版不提供该项。</div>\n    </details>\n  </div>\n\n  <div class=\"faq-group\">\n    <div class=\"glabel\">四、支持与变更</div>\n    <details>\n      <summary>遇到问题找谁？</summary>\n      <div class=\"ans\">旗舰及以上享 7×24 优先工单；团队版另有专属客户经理对接。所有档位均可提交工单，仅响应优先级不同。</div>\n    </details>\n    <details>\n      <summary>中途升级怎么办？</summary>\n      <div class=\"ans\">可随时向更高档位迁移，新权益即时生效。差价与折算规则请在工单中确认后再操作。</div>\n    </details>\n    <details>\n      <summary>退款政策是什么？</summary>\n      <div class=\"ans\">本页未收录经核实的退款细则，不作口头承诺。相关条款以订单页公示及工单答复为准。</div>\n    </details>\n  </div>\n</section>\n\n<footer>\n  <div class=\"brand\">J20</div>\n  <p>深海蓝为底，琥珀色为光。一条被认真维护的路，胜过一句被喊响的口号。</p>\n  <div class=\"links\">\n    <a href=\"#top\">回到顶部</a>\n    <a href=\"#plans\">查看方案</a>\n    <a href=\"#faq\">阅读问答</a>\n  </div>\n  <p>© J20 · 本页面为静态展示，价格与权益以上方正文为准。</p>\n</footer>\n\n</main>",
